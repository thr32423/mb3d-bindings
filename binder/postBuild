#!/bin/bash
# the program mb3d (the latest release of mb3d-rs), where the notebook looks for it
set -euo pipefail
release=https://github.com/thr32423/mb3d-rs/releases/latest/download
folder="$HOME/.cache/mb3d-notebook"
mkdir -p "$folder"
curl -sSfL -o /tmp/mb3d-rs-linux-x64.tar.gz "$release/mb3d-rs-linux-x64.tar.gz"
curl -sSfL "$release/SHA256SUMS" | grep ' mb3d-rs-linux-x64.tar.gz$' | (cd /tmp && sha256sum -c -)
tar xzf /tmp/mb3d-rs-linux-x64.tar.gz -C "$folder" --strip-components=1
rm /tmp/mb3d-rs-linux-x64.tar.gz
"$folder/mb3d" --version
